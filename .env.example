# HydraDB
HYDRADB_BOLT_URI=bolt://127.0.0.1:7687
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes

# MinIO / object storage (for ingestion pipeline)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=blackout-graph
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# LLM extraction (optional, for ingestion)
ANTHROPIC_API_KEY=

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=*

# Frontend
VITE_API_BASE_URL=
FRONTEND_PORT=3000

# Railway (auto-set by platform)
# RAILWAY_PUBLIC_DOMAIN=
# PORT=
